{
  "expo": {
    "name": "JobOps",
    "slug": "jobops",
    "version": "1.0.1",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ccb4d034-82d8-40cc-93f8-b59ed2ccffa7"
    },
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "jobops",
    "backgroundColor": "#F3F7FC",
    "primaryColor": "#1D4ED8",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.jobops.contractor",
      "buildNumber": "4",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.jobops.contractor",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#050B14",
        "foregroundImage": "./assets/images/app-icon-android-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [],
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/JobOps.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/JobOps.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F3F7FC",
          "dark": {
            "image": "./assets/images/JobOps.png",
            "backgroundColor": "#050B14"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/trebuc.ttf",
            "./assets/fonts/Trebuchet-MS-Italic.ttf"
          ]
        }
      ],
      "expo-video",
      "expo-asset",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Job Ops needs access to your photo library so you can select job-site photos, receipt images, and work videos to attach to work orders.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-ios-media-library-only"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "jobOpsRelease": "1.0.1",
      "router": {},
      "eas": {
        "projectId": "ccb4d034-82d8-40cc-93f8-b59ed2ccffa7"
      }
    },
    "owner": "descode8"
  }
}
