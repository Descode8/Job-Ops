{
  "expo": {
    "name": "JobOps",
    "slug": "jobops",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "jobops",
    "backgroundColor": "#F3F7FC",
    "primaryColor": "#1D4ED8",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.jobops.contractor",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.jobops.contractor",
      "adaptiveIcon": {
        "backgroundColor": "#050B14",
        "foregroundImage": "./assets/images/app-icon-android-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/JobOps.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/JobOps.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F3F7FC",
          "dark": {
            "image": "./assets/images/JobOps.png",
            "backgroundColor": "#050B14"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/trebuc.ttf",
            "./assets/fonts/Trebuchet-MS-Italic.ttf"
          ]
        }
      ],
      "expo-video",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ccb4d034-82d8-40cc-93f8-b59ed2ccffa7"
      }
    },
    "owner": "descode8"
  }
}
